# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored - never commit real credentials.
#   cp .env.example .env
#
# v1 runs entirely on this machine: SQL Server, Redis, local file storage,
# local extraction, local embeddings, a local LLM. No cloud account is needed
# and no data leaves the host.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# local | ci | staging | production
APP_ENV=local
LOG_LEVEL=INFO
# console for local readability, json in deployments
LOG_FORMAT=console
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- SQL Server ------------------------------------------------------------
# The SA password must satisfy SQL Server's complexity policy (8+ chars, three
# of: upper, lower, digit, symbol) or the container refuses to start.
MSSQL_SA_PASSWORD=Local_Dev_Sa_Password_1
MSSQL_DB=copilot
MSSQL_PORT=1433

# Application login: owns the schema and runs migrations.
MSSQL_APP_USER=copilot_app
MSSQL_APP_PASSWORD=Local_Dev_App_Password_1

# Restricted login for the SQL agent: SELECT only, writes explicitly denied.
MSSQL_READONLY_USER=copilot_readonly
MSSQL_READONLY_PASSWORD=Local_Dev_ReadOnly_Password_1

# Host-side URLs. Inside docker compose the api service overrides the host to
# `mssql`; use `localhost` when running the API outside the containers.
DATABASE_URL=mssql+aioodbc://copilot_app:Local_Dev_App_Password_1@localhost:1433/copilot?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
READONLY_DATABASE_URL=mssql+aioodbc://copilot_readonly:Local_Dev_ReadOnly_Password_1@localhost:1433/copilot?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
# Hard ceiling on any statement the SQL agent runs, in seconds.
READONLY_QUERY_TIMEOUT_SECONDS=10

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# Generate a real one for anything that is not local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Local document storage (stands in for Azure Blob Storage) -------------
STORAGE_DIR=./.data/storage
MAX_UPLOAD_MB=25

# --- Qdrant (stands in for the Azure AI Search index) ----------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=healthcare-chunks

# --- Local models (stand in for Azure OpenAI / AI Search semantic ranker) ---
# Downloaded once to the model cache on first use.
# fastembed | hash  (hash = deterministic, no model download)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# fastembed's ONNX build of the cross-encoder (the HF name is not accepted).
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODEL_CACHE_DIR=./.data/models

# --- Local LLM (stands in for an Azure OpenAI chat deployment) -------------
# ollama | echo  (echo = deterministic stub, needs no model)
LLM_PROVIDER=echo
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Retrieval defaults (every one of these is an experiment variable) -----
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=50
RRF_K=60
ENABLE_RERANKER=true

# --- Agent (Sprint 4) -------------------------------------------------------
# rule | llm | auto   auto = llm when a real model is configured, rules when
# LLM_PROVIDER=echo, because the echo stub cannot make routing decisions.
AGENT_PLANNER=auto
# Ceiling on tool calls per run, enforced by the dispatcher.
AGENT_MAX_TOOL_CALLS=4
# Free-form natural-language-to-SQL. Off by default: it is the only tool whose
# input is a generated program. Outside local/CI, enabling it requires
# READONLY_DATABASE_URL to be a genuinely separate login or the API will not
# boot. Typed tools (query_lab_results) cover the common questions either way.
SQL_TOOL_ENABLED=false
SQL_MAX_ROWS=200

# --- Seeded demo accounts (scripts/seed.py; local development only) ---------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!local
SEED_CLINICIAN_EMAIL=clinician@example.com
SEED_CLINICIAN_PASSWORD=Clinician123!local
SEED_ANALYST_EMAIL=analyst@example.com
SEED_ANALYST_PASSWORD=Analyst123!local

# --- Frontend --------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
