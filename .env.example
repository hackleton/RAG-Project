# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored - never commit real credentials.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=local                      # local | ci | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console for local readability, json in deployments
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_local_password
POSTGRES_DB=copilot
POSTGRES_PORT=5432
# Password for the restricted role the SQL agent uses (read-only, Sprint 6).
POSTGRES_READONLY_PASSWORD=copilot_readonly_local_password

# Host-side URL. Inside docker compose the api service overrides the host to
# `postgres`; use `localhost` when running the API outside the containers.
DATABASE_URL=postgresql+asyncpg://copilot:copilot_local_password@localhost:5432/copilot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# Generate a real one for anything that is not local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Seeded demo accounts (scripts/seed.py; local development only) ---------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!local
SEED_CLINICIAN_EMAIL=clinician@example.com
SEED_CLINICIAN_PASSWORD=Clinician123!local
SEED_ANALYST_EMAIL=analyst@example.com
SEED_ANALYST_PASSWORD=Analyst123!local

# --- Frontend --------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1

# --- Azure (Sprints 2-4; leave blank until those sprints) ------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=healthcare-chunks
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
